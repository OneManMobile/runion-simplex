feature ccmp {
    sub a uni030A by aring;
    sub A uni030A by Aring;
    sub ansuz uni030A by ansuz_ring;
} ccmp;
feature ss01 {
    featureNames { name "Four-stroke sowilo"; };
    sub sowilo by sowilo.ss01;
} ss01;
